<?xml version="1.0" encoding="utf-8"?>
<!-- BottomSheet for map layers. Populated programmatically by LayerPickerSheet.kt so
     it can host multiple independent toggle groups (map style now, overlay data
     sources like DWD/Autobahn later) without changing this layout. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="@dimen/space_16">

    <!-- Drag handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="14dp"
        android:background="?attr/colorOutline"/>

    <TextView
        android:id="@+id/layerSheetTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/space_20"
        android:paddingBottom="10dp"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="480dp">

        <LinearLayout
            android:id="@+id/layerSheetContent"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

    </ScrollView>

</LinearLayout>
