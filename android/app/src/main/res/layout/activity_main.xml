<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.osmdroid.views.MapView
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <!-- SPATEM traffic-light overlay — unchanged for now, superseded by the
         peek strip's Ampelzelle in step 6 (see CLAUDE.md). -->
    <LinearLayout
        android:id="@+id/spatLight"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#CC111111"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="7dp"
        android:paddingBottom="7dp"
        android:layout_marginTop="@dimen/space_8"
        android:layout_marginStart="@dimen/space_8"
        android:elevation="6dp"
        android:visibility="gone">
        <View android:id="@+id/lightRed"    android:layout_width="18dp" android:layout_height="18dp" android:background="@drawable/ic_status_dot"/>
        <View android:id="@+id/lightYellow" android:layout_width="18dp" android:layout_height="18dp" android:layout_marginStart="5dp" android:background="@drawable/ic_status_dot"/>
        <View android:id="@+id/lightGreen"  android:layout_width="18dp" android:layout_height="18dp" android:layout_marginStart="5dp" android:background="@drawable/ic_status_dot"/>
    </LinearLayout>

    <!-- Speed / bearing overlay — bottom-left of map -->
    <TextView
        android:id="@+id/speedOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:background="#BB000000"
        android:textColor="#FFFFFFFF"
        android:textSize="13sp"
        android:fontFamily="monospace"
        android:padding="6dp"
        android:layout_margin="@dimen/space_8"
        android:elevation="6dp"
        android:visibility="gone"/>

    <!-- C-ITS alert bar (Meldungsleiste) — one chip per active message
         type, count + 30s TTL per type (see MainActivity.CitsAlertBar).
         translationZ above the sheet so alertDetails stays legible over
         it at every snap point, per the handoff README. -->
    <LinearLayout
        android:id="@+id/alertBarRoot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="top|start"
        android:layout_margin="@dimen/space_8"
        android:fitsSystemWindows="true"
        android:elevation="6dp"
        android:translationZ="6dp">

        <LinearLayout
            android:id="@+id/alertBarContainer"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/alert_bar_height"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_alert_bar"
            android:paddingStart="@dimen/space_12"
            android:paddingEnd="@dimen/space_8"
            android:clickable="true"
            android:focusable="true">

            <HorizontalScrollView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/alertBar"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"/>

            </HorizontalScrollView>

            <TextView
                android:id="@+id/alertBarEmptyText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cits_no_events"
                android:textSize="12sp"
                android:textColor="?attr/colorOnSurfaceVariant"/>

            <ImageView
                android:id="@+id/alertBarChevron"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="@dimen/space_4"
                android:visibility="gone"
                android:contentDescription="@string/toggle_section"
                app:srcCompat="@drawable/ic_expand_more"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/alertDetails"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="@dimen/space_12"
            android:elevation="6dp"
            android:visibility="gone"/>

    </LinearLayout>

    <!-- FAB column — positioned bottom|end of the screen, then pushed up via
         translationY (set in MainActivity, tracking the sheet's live top) so
         it rides just above the sheet instead of getting trapped behind it.
         app:layout_anchor was tried first but doesn't track a match_parent-
         height BottomSheetBehavior sheet's peek-adjusted top correctly — see
         CLAUDE.md for the on-device finding. Hidden (alpha 0) at
         STATE_EXPANDED, see MainActivity. -->
    <LinearLayout
        android:id="@+id/fabColumn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:orientation="vertical"
        android:gravity="end"
        android:paddingEnd="@dimen/space_16"
        android:paddingBottom="@dimen/space_4">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabSettings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_8"
            android:contentDescription="@string/settings"
            app:srcCompat="@drawable/ic_settings"
            app:shapeAppearance="@style/ShapeAppearance.V2X.Full"
            app:fabSize="mini"/>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabCompass"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_4"
            android:contentDescription="@string/compass_north_up"
            app:srcCompat="@drawable/ic_compass"
            app:shapeAppearance="@style/ShapeAppearance.V2X.Full"
            app:fabSize="mini"/>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabLayers"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_4"
            android:contentDescription="@string/map_layer_title"
            app:srcCompat="@drawable/ic_layers"
            app:shapeAppearance="@style/ShapeAppearance.V2X.Full"
            app:fabSize="mini"/>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabLocate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/locate"
            app:srcCompat="@drawable/ic_my_location"
            app:shapeAppearance="@style/ShapeAppearance.V2X.Full"/>

    </LinearLayout>

    <!-- Bottom sheet — three snap points (COLLAPSED/HALF_EXPANDED/EXPANDED),
         set up in MainActivity.setupBottomSheet(). height=match_parent so the
         sheet always measures tall enough to reach expandedOffset regardless
         of how much log content exists; peekStrip stays fixed at the top,
         everything below scrolls inside the NestedScrollView. -->
    <LinearLayout
        android:id="@+id/sheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/bg_sheet"
        android:elevation="8dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="@dimen/space_8"
            android:background="?attr/colorOutline"/>

        <!-- Peek strip — always visible at every snap point. Three cells,
             fixed weights (0.44/0.30/0.26) so nothing reflows on state
             change; each value TextView is single-line + ellipsized so a
             long connection status (e.g. "Reconnect #11 (30s)…") truncates
             instead of wrapping and changing the row's height. -->
        <LinearLayout
            android:id="@+id/peekStrip"
            android:layout_width="match_parent"
            android:layout_height="@dimen/sheet_peek_strip"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/space_16"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.44"
                android:orientation="vertical">

                <TextView
                    android:text="@string/source_label"
                    style="@style/Section.PeekLabel"/>

                <TextView
                    android:id="@+id/peekConnStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:fontFamily="monospace"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="OFFLINE"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.30"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    android:text="@string/ampel_section_label"
                    style="@style/Section.PeekLabel"/>

                <org.opentrafficmap.receiver.AmpelCellView
                    android:id="@+id/ampelCell"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.26"
                android:orientation="vertical"
                android:gravity="end">

                <TextView
                    android:text="@string/frames_log_header"
                    android:textAllCaps="true"
                    style="@style/Section.PeekLabel"/>

                <TextView
                    android:id="@+id/peekFrameStats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:gravity="end"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="0 pkts · 0/min"/>
            </LinearLayout>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorOutline"/>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="@dimen/space_16">

                <!-- Source row — full USB/BT toggle + status text, only
                     reachable once the sheet is dragged past peek height. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/space_16"
                    android:paddingTop="@dimen/space_12">

                    <TextView
                        android:text="@string/source_label"
                        style="@style/Section.PeekLabel"/>

                    <TextView
                        android:id="@+id/sourceStatusText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="10sp"
                        android:fontFamily="monospace"
                        android:maxLines="2"
                        android:layout_marginBottom="@dimen/space_8"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        tools:text="CONNECTED ttyACM0@115200"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnConnect"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:minHeight="@dimen/touch_min"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:text="@string/connect"
                            android:textSize="12sp"
                            android:maxLines="1"
                            android:ellipsize="end"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnConnectBt"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:minHeight="@dimen/touch_min"
                            android:layout_weight="1"
                            android:text="@string/connect_bt"
                            android:textSize="12sp"
                            android:maxLines="1"
                            android:ellipsize="end"/>

                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/space_12"
                    android:background="?attr/colorOutline"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/space_16"
                    android:paddingTop="@dimen/space_8"
                    android:text="@string/frames_log_header"
                    style="@style/Section.PeekLabel"/>

                <TextView
                    android:id="@+id/logStats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/space_16"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="0 pkts · 0/min"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/log"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:clipToPadding="false"/>

                <TextView
                    android:id="@+id/emptyLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="14dp"
                    android:gravity="center"
                    android:text="@string/empty_log"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="12sp"/>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
