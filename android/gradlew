#!/usr/bin/env bash
# Compatibility shim: Gradle root moved to the repo root (KMP / M1).
# Old docs often said `cd android && ./gradlew assembleDebug` — keep that
# working by forwarding to the root wrapper and prefixing common app tasks.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
args=()
for a in "$@"; do
  case "$a" in
    assembleDebug|assembleRelease|installDebug|installRelease|bundleRelease|bundleDebug)
      args+=(":androidApp:$a")
      ;;
    *)
      args+=("$a")
      ;;
  esac
done
cd "$ROOT"
exec ./gradlew "${args[@]}"
